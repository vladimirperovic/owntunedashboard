[Unit]
Description=OwnTone Dashboard Scheduler
After=network-online.target owntone.service
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/owntone-dashboard
StateDirectory=owntone-dashboard
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Europe/Belgrade
Environment=OWNTONE_BASE=http://127.0.0.1:3689/api
Environment=OWNTONE_SCHEDULER_HOST=127.0.0.1
Environment=OWNTONE_SCHEDULER_PORT=3691
Environment=OWNTONE_SCHEDULER_DATA=/var/lib/owntone-dashboard
Environment=OWNTONE_STATIONS_DIR=/media/music/Radio
Environment=OWNTONE_PLAYLISTS_DIR=/media/music/Playlists
Environment=OWNTONE_NIGHT_START=0
Environment=OWNTONE_NIGHT_END=8
Environment=OWNTONE_NIGHT_MAX=8
ExecStart=/usr/bin/python3 /opt/owntone-dashboard/scheduler/scheduler_server.py
Restart=on-failure
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/owntone-dashboard /media/music/Radio /media/music/Playlists

[Install]
WantedBy=multi-user.target
